rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function myEmail() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email;
    }
    function isManager() { return isSignedIn() && myRole() in ['owner', 'manager']; }
    function isEmployee() { return isSignedIn() && myRole() == 'employee'; }
    function isGuest() { return isSignedIn() && myRole() == 'guest'; }

    function sharePermission(sheetId) {
      let shares = get(/databases/$(database)/documents/sheets/$(sheetId)).data.sharedWith;
      return (isGuest() && myEmail() in shares) ? shares[myEmail()] : null;
    }
    function isSharedViewer(sheetId) { return sharePermission(sheetId) in ['view', 'edit']; }
    function isSharedEditor(sheetId) { return sharePermission(sheetId) == 'edit'; }

    // "anyone with the link" — works even for a completely anonymous,
    // never-signed-in visitor, since it only reads the sheet's own
    // publicAccess field, no user lookup involved
    function publicAccessOf(sheetId) {
      return get(/databases/$(database)/documents/sheets/$(sheetId)).data.publicAccess;
    }
    function isPubliclyViewable(sheetId) { return publicAccessOf(sheetId) in ['view', 'edit']; }
    function isPubliclyEditable(sheetId) { return publicAccessOf(sheetId) == 'edit'; }

    function isAssigned(sheetId) {
      return isManager() ||
        sheetId == 'daily-report' || sheetId == 'attendance' ||
        (isEmployee() &&
          request.auth.uid in get(/databases/$(database)/documents/sheets/$(sheetId)).data.assignedEmployees) ||
        isSharedViewer(sheetId) ||
        isPubliclyViewable(sheetId);
    }
    function canEditSheet(sheetId) {
      return isManager() ||
        (isEmployee() &&
          request.auth.uid in get(/databases/$(database)/documents/sheets/$(sheetId)).data.assignedEmployees) ||
        isSharedEditor(sheetId) ||
        isPubliclyEditable(sheetId);
    }
    function isIdentitySheet(sheetId) {
      return sheetId == 'daily-report' || sheetId == 'attendance';
    }

    // one-time "has an Owner been created yet" flag — publicly readable
    // so the sign-up screen can check it before anyone logs in
    match /meta/setup {
      allow read: if true;
      allow write: if isSignedIn() &&
        (!exists(/databases/$(database)/documents/meta/setup) ||
         get(/databases/$(database)/documents/meta/setup).data.ownerCreated == false) &&
        request.resource.data.ownerCreated == true;
    }
    match /meta/sheetsSeeded {
      allow read: if true;
      allow write: if isManager();
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      // self-signup cases (owner/manager first account, guest) require
      // the requester to BE the account being created. Manager-creates-
      // employee is different — the manager is creating a doc for
      // someone else's ID entirely, so that branch checks isManager()
      // instead, not a uid match.
      allow create: if
        (request.auth.uid == uid && (
          (request.resource.data.role in ['owner', 'manager'] &&
            (!exists(/databases/$(database)/documents/meta/setup) ||
             get(/databases/$(database)/documents/meta/setup).data.ownerCreated == false)) ||
          request.resource.data.role == 'guest'
        )) ||
        (isManager() && request.resource.data.role == 'employee');
      allow update: if isSignedIn() && (request.auth.uid == uid || isManager());
      allow delete: if isManager();
    }

    match /sheets/{sheetId} {
      // note: this also lets an anonymous public-link visitor read the
      // sheet's name/columns (never its rows without the rule below too)
      allow read: if isAssigned(sheetId);
      allow create, delete: if isManager();
      // everyone who can edit the sheet can add/rename period tabs —
      // but ONLY that one field; columns, assignedEmployees, sharedWith,
      // and publicAccess stay manager-only to change
      allow update: if isManager() ||
        (canEditSheet(sheetId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['periods']));

      match /rows/{rowId} {
        allow read: if isManager() ||
          (!isIdentitySheet(sheetId) && isAssigned(sheetId)) ||
          (isIdentitySheet(sheetId) && isEmployee() && resource.data._ownerUid == request.auth.uid);
        allow create, update: if isManager() ||
          (!isIdentitySheet(sheetId) && isEmployee() &&
            request.auth.uid in get(/databases/$(database)/documents/sheets/$(sheetId)).data.assignedEmployees) ||
          (!isIdentitySheet(sheetId) && isSharedEditor(sheetId)) ||
          (!isIdentitySheet(sheetId) && isPubliclyEditable(sheetId)) ||
          (isIdentitySheet(sheetId) && isEmployee() && request.resource.data._ownerUid == request.auth.uid);
        allow delete: if isManager() ||
          (!isIdentitySheet(sheetId) && isEmployee() &&
            request.auth.uid in get(/databases/$(database)/documents/sheets/$(sheetId)).data.assignedEmployees) ||
          (!isIdentitySheet(sheetId) && isSharedEditor(sheetId)) ||
          (!isIdentitySheet(sheetId) && isPubliclyEditable(sheetId)) ||
          (isIdentitySheet(sheetId) && isEmployee() && resource.data._ownerUid == request.auth.uid);
      }
    }

    match /bankDetails/{doc} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }
  }
}
